# Copy to the Forge config directory as rdp-uav-targets.cfg.
[safety]
# Reject contacts whose feet are buried in solid ground.
rejectDeeplyEmbedded=true
# Maximum tolerated depth below the supporting block top.
maximumEmbeddedDepth=1.5
[filter]
# Include hostile military/bandit vehicles in searches and locks.
allowHostileVehicles=true
