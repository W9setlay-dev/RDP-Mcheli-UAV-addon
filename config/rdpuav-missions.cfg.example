# RDP UAV mission defaults for the Forge 1.12.2 addon.
# Copy this file to the instance config directory after installing the addon.

mission_update_interval_ticks=10
target_tracking_interval_ticks=10
quick_scan_interval_ticks=20
deep_scan_interval_ticks=40
default_search_radius=256
default_observation_distance=64
max_search_radius=1024
automatic_missions_enabled=false
allow_player_abort=true

# Square strike geometry is a reusable-UAV mission only. Point/entity attack
# remains the correct behavior for ONE_WAY FPV/kamikaze aircraft.
# These values are consumed by native WingMan route generation.
# See rdp-uav-square-strike.cfg in the instance config directory.

# The addon recognizes these aircraft as kamikaze-capable only when the
# installed McHeli aircraft definition also has a self-destructing weapon.
kamikaze_aircraft=switchblade,shahed136

# Explicit McHeli definition/profile mapping. Names are definition names, not
# display-name matching. Add aliases for the exact names used by your pack.
# Reusable UAVs navigate horizontally at executionAltitude and hold altitude.
[vehicle.switchblade]
profile=ONE_WAY
aliases=switchblade
terminalPayloadBehavior=SELF_DESTRUCT

[vehicle.shahed136]
profile=ONE_WAY
aliases=shahed136,shahed-136
terminalPayloadBehavior=SELF_DESTRUCT

[vehicle.fpvdrone]
profile=ONE_WAY
aliases=fpv,fpv-drone,fpv_drone
altitudeTolerance=4
holdingEnabled=false
terminalPayloadBehavior=SELF_DESTRUCT

[vehicle.mq9]
profile=LONG_RANGE_REUSABLE_UAV
aliases=mq-9,mq_9,reaper,predator
executionAltitude=250
minimumExecutionAltitude=200
maximumExecutionAltitude=320
altitudeTolerance=15
holdingEnabled=true
terminalPayloadBehavior=NONE
detectionRange=2048
lockRange=1536
missionExecutionRange=64
# Configure attackWeaponPriority in rdp-uav-vehicles.cfg:
# agm114,agm114tv
# Vehicle profiles also accept bounded native routing envelopes:
# oneWaySpeed=0 (native McHeli default; no projectile steering is emulated)
# attackEnvelope=64 (passed to the native WingMan ATTACK node)
