# Copy to the Forge config directory as rdp-uav-guided-weapons.cfg.
# Keys are McHeli MCH_WeaponSet definition/type pairs, not display names.
[weapon.aamissile]
type=aamissile
behavior=ENTITY_SEEKER
objectives=ENTITY
maximumAircraftSpeed=0
minimumAltitude=0
maximumAltitude=4096
noOrbit=true

[weapon.atmissile]
type=atmissile
behavior=ENTITY_SEEKER
objectives=ENTITY
maximumAircraftSpeed=0
minimumAltitude=0
maximumAltitude=4096
noOrbit=true

[weapon.asmissile]
type=asmissile
behavior=COORDINATE_BALLISTIC
objectives=ENTITY,SQUARE
maximumAircraftSpeed=0
minimumAltitude=0
maximumAltitude=4096
noOrbit=true

[weapon.tvmissile]
type=tvmissile
behavior=COORDINATE_TV_LASER
objectives=ENTITY,SQUARE
maximumAircraftSpeed=0
minimumAltitude=0
maximumAltitude=4096
noOrbit=true

# An active authorized mission owns TV guidance even when the player is
# viewing the missile camera. Abort clears the AI ownership and returns to
# native player guidance where McHeli supports it.
# COORDINATE_BALLISTIC preserves the weapon's native gravity and collision;
# the addon only validates the release corridor and submits the target point.

# Unsupported combinations are rejected server-side. This registry does not
# create projectiles, mutate projectile position/velocity, or replace McHeli
# seeker/TV/laser code.
# minimumAltitude/maximumAltitude bound terminal target elevation, including
# low-altitude close support and high-altitude release profiles.
